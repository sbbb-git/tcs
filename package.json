{
  "name": "talentcare-sante",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine et blog SEO de TalentCare Santé, cabinet de recrutement spécialisé santé.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
