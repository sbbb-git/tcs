# Cloudflare Pages headers.
# This file is copied verbatim to the build output root.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Fingerprinted build assets never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

# Les cartes de partage des annonces sont rendues au build par la convention
# `opengraph-image` de Next, qui produit des fichiers SANS extension. Un
# hébergeur statique devine alors le type MIME et se trompe : les robots des
# réseaux sociaux refusent la réponse et le partage part sans aperçu. Le type
# doit donc être imposé ici.
/offres-emploi/:slug/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=604800
